{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|NotebookRead|Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "secret-mask hook",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "secret-mask hook",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
